DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zalo_chatbot
CLOUDINARY_CLOUD_NAME=dszkt92jr
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=zalo-chatbot/dev
IMPORT_STORAGE_PATH=
IMPORT_STORAGE_PATH=/your/path/to/imports
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
LOCAL_EMBEDDING_BASE_URL=
OPENAI_API_KEY=
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=qwen3-embedding:0.6b
LOCAL_EMBEDDING_BASE_URL=http://localhost:11434
LOCAL_EMBEDDING_KEEP_ALIVE=30m
SEMANTIC_SEARCH_MIN_SCORE=
HYBRID_LEXICAL_WEIGHT=
HYBRID_SEMANTIC_WEIGHT=
HYBRID_RRF_K=
LLM_PROVIDER=local
LLM_MODEL=qwen3:8b
LOCAL_LLM_BASE_URL=http://localhost:11434
LOCAL_AI_WARMUP_ENABLED=true
CHAT_RAG_MAX_CONTEXT_CHARS=
CHAT_HUMAN_CONTACT_FALLBACK_MESSAGE=
LLM_PERF_LOG=false
AUTH_SESSION_TTL_HOURS=24
ZALO_APP_ID=
# Application Secret Key from Zalo app settings. Used only for OAuth token refresh.
ZALO_APP_SECRET_KEY=
# Exactly 32 random bytes, encoded as base64 (or 64 hexadecimal characters). Used to encrypt DB credentials.
ZALO_TOKEN_ENCRYPTION_KEY=
# OA Secret Key from webhook settings. Used only for webhook signature verification.
ZALO_OA_SECRET_KEY=
# Bootstrap only. Remove both values after `yarn zalo:tokens:seed` succeeds.
ZALO_OA_ACCESS_TOKEN=
ZALO_OA_REFRESH_TOKEN=
ZALO_DEFAULT_AUDIENCE=CUSTOMER
ZALO_WEBHOOK_PROCESSING_ENABLED=true
# Only for initial Zalo webhook registration; disable immediately after it succeeds.
ZALO_WEBHOOK_BOOTSTRAP_MODE=false
SEED_ADMIN_EMAIL=
SEED_ADMIN_FULL_NAME=
SEED_ADMIN_PASSWORD=
